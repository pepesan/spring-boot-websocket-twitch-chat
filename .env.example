# Copy to .env; never commit .env or paste real values into Git.
# Create a Twitch app at https://dev.twitch.tv/console/apps with redirect URL:
# http://localhost:8080/callback/twitch
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8080/callback/twitch
# Generate with: ./gradlew generateTwitchCredentialKeyset
TWITCH_TOKEN_ENCRYPTION_KEYSET=
# Local development creator account. Use a unique email and password of at least 12 characters.
DEVELOPMENT_CREATOR_EMAIL=
DEVELOPMENT_CREATOR_PASSWORD=
