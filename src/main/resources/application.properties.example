# Configuración de la base de datos H2
spring.datasource.url=jdbc:h2:mem:testdb
spring.datasource.driverClassName=org.h2.Driver
spring.datasource.username=sa
spring.datasource.password=
spring.jpa.database-platform=org.hibernate.dialect.H2Dialect
twitch.clientId=MY_CLIENT_ID
twitch.clientSecret=MY_CLIENT_SECRET
twitch.redirect_uri=http://localhost:8080/callback/twitch

# Credenciales OAuth por proveedor: SQLite y keyset AES-GCM generado por Google Tink.
oauth.credentials.database=./data/oauth-credentials.sqlite
# Configurar TWITCH_TOKEN_ENCRYPTION_KEYSET con el keyset Base64 generado por la aplicación.
twitch.credentials.encryption-keyset=${TWITCH_TOKEN_ENCRYPTION_KEYSET:}
